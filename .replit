modules = ["nodejs-20", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_database:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Media Tracker App"

[[workflows.workflow]]
name = "Media Tracker App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd media-tracker && npm run dev"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 35003
externalPort = 4200

[[ports]]
localPort = 36403
externalPort = 3000

[[ports]]
localPort = 39001
externalPort = 3003

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "--prefix", "media-tracker", "start"]
build = ["bash", "-c", "npm --prefix media-tracker install && npm --prefix media-tracker run build"]

[nix]
channel = "stable-25_05"
